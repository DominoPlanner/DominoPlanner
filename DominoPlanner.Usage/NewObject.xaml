<Window
    x:Class="DominoPlanner.Usage.NewObject"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:View="clr-namespace:DominoPlanner.Usage.UserControls.View"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DominoPlanner.Usage"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:DominoPlanner.Usage.UserControls.ViewModel"
    Title="{local:Gettext Window title|New object}"
    Width="650"
    Height="635"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="local:NewObjectVM"
    CanResize="False"
    Icon="/Icons/DominoCalculator.ico"
    mc:Ignorable="d">
    <Window.DataTemplates>
        <DataTemplate DataType="{x:Type vm:CreateFieldVM}">
            <View:FieldSize HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CreateRectangularStructureVM}">
            <View:RectangularSize HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CreateCircleVM}">
            <View:CircleSize HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CreateSpiralVM}">
            <View:SpiralSize HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </DataTemplate>


        <DataTemplate DataType="{x:Type local:SingleImageInformation}">
            <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <TextBlock
                    Margin="5"
                    HorizontalAlignment="Stretch"
                    DockPanel.Dock="Top"
                    Text="{Binding InternPictureName, StringFormat={local:Gettext 'Image Source: {0}'}}"
                    TextWrapping="Wrap" />
                <Border
                    VerticalAlignment="Stretch"
                    local:FileDragDropHelper.FileDragDropTarget="{Binding Path=.}"
                    local:FileDragDropHelper.IsFileDragDropEnabled="True"
                    Background="White"
                    BorderBrush="Black"
                    BorderThickness="1"
                    DockPanel.Dock="Bottom"
                    DragDrop.AllowDrop="True">
                    <ContentControl Content="{Binding InternPictureName}">
                        <ContentControl.Resources>
                            <DataTemplate x:Key="ImageTemplate">
                                <Image Source="{Binding DataContext, RelativeSource={RelativeSource Self}, Converter={StaticResource BitmapValueConverter}}" />
                            </DataTemplate>
                            <DataTemplate x:Key="EmptyImageTemplate">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{local:Gettext Click to select an image\\n(or drop it here)}" />
                            </DataTemplate>
                        </ContentControl.Resources>
                        <ContentControl.DataTemplates>
                            <local:ImageTemplateSelector EmptyImageTemplate="{StaticResource EmptyImageTemplate}" ImageTemplate="{StaticResource ImageTemplate}" />
                        </ContentControl.DataTemplates>
                        <Interaction.Behaviors>
                            <EventTriggerBehavior EventName="PointerReleased">
                                <InvokeCommandAction Command="{Binding LoadNewImage}" />
                            </EventTriggerBehavior>
                        </Interaction.Behaviors>
                    </ContentControl>
                </Border>
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:NoImageInformation}" />
        <DataTemplate DataType="{x:Type local:NewAssemblyEntry}">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="{local:Gettext Color path (inherited from parent):}" />
                <TextBlock
                    Margin="5,0,0,0"
                    Text="{Binding ColorPath}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

    </Window.DataTemplates>
    <Window.Resources>
        <local:BitmapValueConverter x:Key="BitmapValueConverter" />
    </Window.Resources>
    <Grid>

        <DockPanel Margin="2" VerticalAlignment="Stretch">
            <local:ImageButton
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Command="{Binding CreateIt}"
                Content="{local:Gettext Create}"
                DockPanel.Dock="Bottom"
                Image="/Icons/ok.ico"
                IsDefault="True" />
            <StackPanel DockPanel.Dock="Right">
                <TextBlock Text="{local:Gettext Object specific settings:}" />
                <ContentControl
                    Width="300"
                    Margin="5"
                    Content="{Binding CurrentViewModel}" />
            </StackPanel>
            <Border
                Width="1"
                BorderBrush="Black"
                BorderThickness="1"
                DockPanel.Dock="Right" />
            <DockPanel
                Margin="5"
                DockPanel.Dock="Top"
                LastChildFill="True">
                <TextBlock VerticalAlignment="Center" Text="{local:Gettext Filename:}" />
                <TextBlock
                    Margin="0,2,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    Text="{Binding Extension}" />
                <TextBox
                    Margin="5,0,0,0"
                    VerticalContentAlignment="Center"
                    Text="{Binding Filename}"
                    TextWrapping="Wrap" />
            </DockPanel>
            <ListBox
                Height="250"
                Margin="5"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                BorderThickness="2"
                DockPanel.Dock="Top"
                ItemsSource="{Binding ViewModels}"
                SelectedIndex="{Binding SelectedType}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0"
                            HorizontalAlignment="Stretch"
                            BorderBrush="Black"
                            BorderThickness="0,0,0,1">
                            <StackPanel
                                Margin="2,2,2,4"
                                HorizontalAlignment="Stretch"
                                Orientation="Horizontal">
                                <Image
                                    Height="36"
                                    VerticalAlignment="Center"
                                    Source="{Binding Icon}" />
                                <StackPanel Margin="3,0,0,0" Orientation="Vertical">
                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="Bold"
                                        Text="{Binding Name}" />
                                    <TextBlock Text="{Binding Description}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ContentControl
                Margin="5"
                Content="{Binding CurrentImageInformation}"
                DockPanel.Dock="Top" />

        </DockPanel>
    </Grid>
</Window>
