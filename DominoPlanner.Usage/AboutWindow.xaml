<Window
    x:Class="DominoPlanner.Usage.AboutWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DominoPlanner.Usage"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="About DominoPlanner"
    Width="350"
    Height="350"
    x:DataType="local:AboutWindowViewModel"
    CanResize="False"
    mc:Ignorable="d">
    <Window.Styles>
        <Style Selector="TextBox /template/ TextPresenter">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>
    <StackPanel Margin="5" Orientation="Vertical">
        <Image
            Width="160"
            Margin="40,20"
            HorizontalAlignment="Left"
            Source="/Icons/DominoCalculator.png" />
        <Button
            Margin="0,5"
            HorizontalAlignment="Left"
            Command="{Binding CopyVersionToClipboard}"
            ToolTip.Tip="{local:Gettext Click to copy version to clipboard}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{local:Gettext DominoPlanner}" />
                <TextBlock Margin="5,0,0,0" Text="{Binding Version}" />
            </StackPanel>
        </Button>
        <TextBlock Margin="0,5,0,0" Text="{local:Gettext 'Developed by:'}" />
        <TextBlock Text="{Binding Authors}" />
        <TextBlock Text="{local:Gettext 'DominoPlanner ist free software, licensed under GNU GPL 3.0.'}" />
        <TextBlock
            Margin="0,5,0,0"
            HorizontalAlignment="Center"
            Text="" />
        <Button
            Margin="0,5"
            HorizontalAlignment="Left"
            Command="{Binding ReportBug}"
            ToolTip.Tip="{Binding IssueTracker}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{local:Gettext 'For feature requests and bug reports, click here.'}" />
            </StackPanel>
        </Button>
        <StackPanel Margin="0,5" Orientation="Horizontal">
            <TextBlock
                Margin="0,0,5,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="{local:Gettext 'You can buy us a coffee here:'}" />
            <Button
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Command="{Binding OpenPayPal}"
                ToolTip.Tip="{Binding DonateLink}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{local:Gettext Donate}" />
                </StackPanel>
            </Button>
        </StackPanel>

    </StackPanel>
</Window>
