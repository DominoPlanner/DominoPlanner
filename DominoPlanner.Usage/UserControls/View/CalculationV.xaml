<UserControl
    x:Class="DominoPlanner.Usage.UserControls.View.CalculationV"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:;assembly=DominoPlanner.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DominoPlanner.Usage"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    xmlns:view="clr-namespace:DominoPlanner.Usage.UserControls.View"
    xmlns:vm="clr-namespace:DominoPlanner.Usage.UserControls.ViewModel"
    d:DesignHeight="300"
    d:DesignWidth="300"
    x:DataType="vm:NonEmptyCalculationVM"
    mc:Ignorable="d">
    <UserControl.DataTemplates>
        <DataTemplate DataType="{x:Type vm:IterativeColorRestrictionVM}">
            <Grid
                Margin="0,2,0,0"
                ColumnDefinitions="203*, 36*"
                RowDefinitions="Auto, 2, Auto">

                <Grid
                    Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Margin="0,0,-0.143,0.429"
                    ColumnDefinitions="1.5*, 2.5*, 2*">
                    <TextBlock Grid.Column="0" Text="{local:Gettext Penalty:}" />
                    <Slider
                        Grid.Column="1"
                        Margin="0,5,0,0"
                        LargeChange="0.1"
                        Maximum="0.5"
                        Minimum="0"
                        SmallChange="0.01"
                        TickFrequency="0"
                        TickPlacement="BottomRight"
                        Value="{Binding Weight}" />
                    <NumericUpDown
                        Grid.Column="2"
                        FormatString="F3"
                        Increment="0.001"
                        Maximum="0.5"
                        Minimum="0"
                        Value="{Binding Weight}" />
                </Grid>
                <Grid
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Margin="0,0.143,-0.143,0.286"
                    ColumnDefinitions="2*, *">
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{local:Gettext Number of attempts:}" />
                    <NumericUpDown
                        Grid.Column="1"
                        VerticalAlignment="Stretch"
                        Minimum="1"
                        Value="{Binding Iterations}" />
                </Grid>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NoColorRestrictionVM}">
            <Grid />
        </DataTemplate>
    </UserControl.DataTemplates>
    <UserControl.Resources>
        <local:BoolToImageConverter x:Key="BoolToImageConverter" />
        <local:ColorModeToIntConverter x:Key="ColorModeToIntConverter" />
        <local:ColorModeToStringConverter x:Key="ColorModeToStringConverter" />
        <local:DitheringToIntConverter x:Key="DitheringToIntConverter" />
        <local:DitheringToStringConverter x:Key="DitheringToStringConverter" />
        <local:IterationInformationToBooleanConverter x:Key="IterationInformationToBooleanConverter" />
    </UserControl.Resources>
    <Grid>
        <StackPanel>
            <HeaderedContentControl Header="{Binding ColorMode, Converter={StaticResource ColorModeToStringConverter}, StringFormat={local:Gettext 'Color Comparison: {0}'}}">
                <Grid ColumnDefinitions="1*, 3*, 1.5*">
                    <TextBlock
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="{local:Gettext Fast}" />
                    <Slider
                        Grid.Column="1"
                        Margin="0,5,0,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Maximum="3"
                        Minimum="0"
                        TickPlacement="BottomRight"
                        Value="{Binding ColorMode, Converter={StaticResource ColorModeToIntConverter}}" />
                    <TextBlock
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Text="{local:Gettext Accurate}" />
                </Grid>
            </HeaderedContentControl>
            <HeaderedContentControl Header="{Binding Dithering, Converter={StaticResource DitheringToStringConverter}, StringFormat={local:Gettext 'Dithering method|Diffusion: {0}'}}">
                <Grid ColumnDefinitions="1*, 3*, 1.5*">
                    <TextBlock
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="{local:Gettext Dithering Method|None}" />
                    <Slider
                        Grid.Column="1"
                        Margin="0,5,0,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Maximum="3"
                        Minimum="0"
                        TickPlacement="BottomRight"
                        Value="{Binding Dithering, Converter={StaticResource DitheringToIntConverter}}" />
                    <TextBlock
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Text="{local:Gettext Slow}" />
                </Grid>
            </HeaderedContentControl>
            <HeaderedContentControl Header="{local:Gettext Transparency Threshold}">
                <Grid ColumnDefinitions="1*, 3*, 1.5*">
                    <TextBlock
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="0" />
                    <Slider
                        Grid.Column="1"
                        Margin="0,5,0,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        Maximum="255"
                        Minimum="0"
                        TickFrequency="0"
                        TickPlacement="BottomRight"
                        Value="{Binding TransparencySetting}" />
                    <TextBlock
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Text="255" />
                </Grid>
            </HeaderedContentControl>
            <HeaderedContentControl>
                <HeaderedContentControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox
                            x:Name="TryMatchCheck"
                            VerticalAlignment="Center"
                            Content="{local:Gettext Try to match Available dominoes}"
                            IsChecked="{Binding IterationInformation, Converter={StaticResource IterationInformationToBooleanConverter}, Mode=OneWay}">
                            <Interaction.Behaviors>
                                <EventTriggerBehavior EventName="Checked">
                                    <InvokeCommandAction Command="{Binding IterationInformationChanged}" CommandParameter="{Binding IsChecked, ElementName=TryMatchCheck}" />
                                </EventTriggerBehavior>
                                <EventTriggerBehavior EventName="Unchecked">
                                    <InvokeCommandAction Command="{Binding IterationInformationChanged}" CommandParameter="{Binding IsChecked, ElementName=TryMatchCheck}" />
                                </EventTriggerBehavior>
                            </Interaction.Behaviors>
                        </CheckBox>
                        <Button
                            Width="20"
                            Height="20"
                            Margin="10,0,0,0"
                            x:DataType="vm:DominoProviderVM"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Command="{Binding OpenPopup}"
                            DataContext="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=view:BasicSettings}, Path=DataContext}"
                            ToolTip.Tip="{local:Gettext Show usage of colors}">
                            <StackPanel>
                                <Image Source="{Binding Converter={StaticResource BoolToImageConverter}, Path=ColorRestrictionFulfilled}" />
                                <Popup
                                    Name="myPopup"
                                    IsLightDismissEnabled="True"
                                    IsOpen="{Binding PopupOpen, Mode=TwoWay}">
                                    <Popup.DataTemplates>
                                        <DataTemplate DataType="{x:Type system:Double}">
                                            <TextBlock Text="{Binding, StringFormat={}{0:0.###}}" />
                                        </DataTemplate>
                                    </Popup.DataTemplates>
                                    <local:ColorControl
                                        Grid.Row="2"
                                        Width="400"
                                        MaxHeight="250"
                                        Colors="{Binding SortedColors}"
                                        ColumnConfig="{Binding ColorColumnConfig}" />
                                </Popup>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </HeaderedContentControl.Header>
                <ContentControl Content="{Binding IterationInformationVM}" />
            </HeaderedContentControl>
        </StackPanel>
    </Grid>
</UserControl>
