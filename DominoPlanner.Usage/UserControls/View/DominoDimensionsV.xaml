<UserControl
    x:Class="DominoPlanner.Usage.UserControls.View.DominoDimensionsV"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DominoPlanner.Usage"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ucView="using:DominoPlanner.Usage.UserControls.View"
    xmlns:vm="clr-namespace:DominoPlanner.Usage.UserControls.ViewModel"
    d:DesignHeight="90"
    d:DesignWidth="300"
    x:DataType="ucView:DominoDimensionsV"
    mc:Ignorable="d">
    <Grid x:Name="LayoutRoot">
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" />
                <ColumnDefinition Width="8*" />
                <ColumnDefinition Width="7*" />
                <ColumnDefinition Width="8*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="3*" />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Text="{Binding Source={x:Static local:UserSettings.Instance}, Path=UseImperialUnits, Converter={StaticResource LengthUnitLabelConverter}, ConverterParameter='Width:'}" />
            <local:LengthNumericUpDown
                Grid.Row="0"
                Grid.Column="1"
                Width="70"
                Minimum="0"
                FormatString="0.##"
                ParsingNumberStyle="Float"
                Classes="LengthInput"
                Millimeters="{Binding TangentialWidth, Mode=TwoWay}"
                Increment="{Binding Source={x:Static local:UserSettings.Instance}, Path=UseImperialUnits, Converter={StaticResource LengthStepConverter}}">
            </local:LengthNumericUpDown>
            <TextBlock
                Grid.Row="0"
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Text="{Binding Source={x:Static local:UserSettings.Instance}, Path=UseImperialUnits, Converter={StaticResource LengthUnitLabelConverter}, ConverterParameter='Length:'}" />
            <local:LengthNumericUpDown
                Grid.Row="0"
                Grid.Column="3"
                Width="70"
                Minimum="0"
                FormatString="0.##"
                ParsingNumberStyle="Float"
                Classes="LengthInput"
                Millimeters="{Binding NormalWidth, Mode=TwoWay}"
                Increment="{Binding Source={x:Static local:UserSettings.Instance}, Path=UseImperialUnits, Converter={StaticResource LengthStepConverter}}">
            </local:LengthNumericUpDown>
            <TextBlock
                Grid.Row="1"
                VerticalAlignment="Center"
                Text="{Binding Source={x:Static local:UserSettings.Instance}, Path=UseImperialUnits, Converter={StaticResource LengthUnitLabelConverter}, ConverterParameter='Distances:'}" />
            <TextBlock
                Grid.Row="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                TextAlignment="Center">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource LengthUnitLabelConverter}" Mode="OneWay">
                        <Binding Path="TangentialDistanceText" />
                        <Binding Source="{x:Static local:UserSettings.Instance}" Path="UseImperialUnits" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <local:LengthNumericUpDown
                Grid.Row="2"
                Grid.Column="1"
                Width="70"
                Minimum="0"
                FormatString="0.##"
                ParsingNumberStyle="Float"
                Classes="LengthInput"
                Millimeters="{Binding TangentialDistance, Mode=TwoWay}"
                Increment="{Binding Source={x:Static local:UserSettings.Instance}, Path=UseImperialUnits, Converter={StaticResource LengthStepConverter}}">
            </local:LengthNumericUpDown>
            <TextBlock
                Grid.Row="2"
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                TextAlignment="Center">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource LengthUnitLabelConverter}" Mode="OneWay">
                        <Binding Path="NormalDistanceText" />
                        <Binding Source="{x:Static local:UserSettings.Instance}" Path="UseImperialUnits" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <local:LengthNumericUpDown
                Grid.Row="2"
                Grid.Column="3"
                Width="70"
                Minimum="0"
                FormatString="0.##"
                ParsingNumberStyle="Float"
                Classes="LengthInput"
                Millimeters="{Binding NormalDistance, Mode=TwoWay}"
                Increment="{Binding Source={x:Static local:UserSettings.Instance}, Path=UseImperialUnits, Converter={StaticResource LengthStepConverter}}">
            </local:LengthNumericUpDown>
        </Grid>
    </Grid>
</UserControl>
