<UserControl
    x:Class="DominoPlanner.Usage.ColorControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="clr-namespace:DominoPlanner.Usage.UserControls.View;assembly=DominoPlanner.Usage"
    xmlns:local="clr-namespace:DominoPlanner.Usage.UserControls.ViewModel;assembly=DominoPlanner.Usage"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:DominoPlanner.Usage;assembly=DominoPlanner.Usage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:ColorControl"
    mc:Ignorable="d">
    <UserControl.Resources>
        <local:DeletedColorVisibilityConverter x:Key="DeletedColorVisibilityConverter" />
        <vm:IntToStringConverter x:Key="IntToStringConverter" />
    </UserControl.Resources>
    <Border BorderBrush="{DynamicResource ThemeBorderHighBrush}" BorderThickness="1">
        <ScrollViewer
            Name="OuterScrollViewer"
            HorizontalScrollBarVisibility="Visible"
            VerticalScrollBarVisibility="Disabled">
            <Grid
                Name="LayoutRoot"
                ColumnDefinitions="*"
                Grid.IsSharedSizeScope="True"
                RowDefinitions="Auto, *">
                <Grid.Styles>
                    <Style Selector="ListBox">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                    <Style Selector="ListBox ContentControl">
                        <Setter Property="Margin" Value="2,0" />
                    </Style>
                    <Style Selector="TextBlock.Header">
                        <Setter Property="Margin" Value="2,0" />
                        <Setter Property="FontWeight" Value="Bold" />
                    </Style>
                    <Style Selector="ContentControl.FixedWidth TextBlock">
                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    </Style>
                    <Style Selector="ListBoxItem Grid">
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                    <Style Selector="ListBox ContentControl.Count">
                        <Setter Property="Template">
                            <ControlTemplate>
                                <TextBlock Text="{TemplateBinding Content, Converter={StaticResource IntToStringConverter}}" />
                            </ControlTemplate>
                        </Setter>
                    </Style>
                    <Style Selector="ListBox ContentControl.Color">
                        <Setter Property="Template">
                            <ControlTemplate>
                                <Rectangle Width="40" Height="20">
                                    <Rectangle.Fill>
                                        <SolidColorBrush Color="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                                    </Rectangle.Fill>
                                </Rectangle>
                            </ControlTemplate>
                        </Setter>
                    </Style>
                    <Style Selector="ListBoxItem">
                        <Setter Property="IsVisible">
                            <MultiBinding Converter="{StaticResource DeletedColorVisibilityConverter}">
                                <Binding x:DataType="vm:ColorListEntry" Path="Deleted" />
                                <Binding x:DataType="vm:ColorListEntry" Path="ProjectCount" />
                            </MultiBinding>
                        </Setter>
                    </Style>
                    <Style Selector="ContentControl.Header">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Border BorderBrush="Orange" BorderThickness="1,0,1,2">
                                        <TextBlock
                                            Margin="5,2"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            FontWeight="Bold"
                                            Text="{TemplateBinding Content}" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Grid.Styles>
                <Grid Name="HeaderGrid" Grid.Row="0" />
                <ListBox
                    Name="ItemsControl"
                    Grid.Row="1"
                    ItemsSource="{Binding Colors}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Hidden"
                    SelectedItem="{Binding SelectedColor}" />
            </Grid>
        </ScrollViewer>
    </Border>

</UserControl>
