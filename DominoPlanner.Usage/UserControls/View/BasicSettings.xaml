<UserControl
    x:Class="DominoPlanner.Usage.UserControls.View.BasicSettings"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DominoPlanner.Usage"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:view="clr-namespace:DominoPlanner.Usage.UserControls.View"
    xmlns:vm="clr-namespace:DominoPlanner.Usage.UserControls.ViewModel"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:DominoProviderVM"
    mc:Ignorable="d">
    <UserControl.Styles>
        <Style Selector="Expander">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="DarkGray" />
            <Setter Property="Foreground" Value="#202020" />
            <Setter Property="Margin" Value="0, 5, 0, 0" />
        </Style>
    </UserControl.Styles>
    <UserControl.DataTemplates>
        <DataTemplate DataType="{x:Type vm:CalculationVM}">
            <view:CalculationV VerticalAlignment="Top" HorizontalContentAlignment="Stretch" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FieldReadoutVM}">
            <view:FieldReadoutV VerticalAlignment="Top" HorizontalContentAlignment="Stretch" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NormalReadoutVM}">
            <view:StructureReadoutV VerticalAlignment="Top" HorizontalContentAlignment="Stretch" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CreateFieldVM}">
            <view:FieldSize VerticalAlignment="Top" HorizontalContentAlignment="Stretch" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CreateRectangularStructureVM}">
            <view:RectangularSize VerticalAlignment="Top" HorizontalContentAlignment="Stretch" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CreateCircleVM}">
            <view:CircleSize VerticalAlignment="Top" HorizontalContentAlignment="Stretch" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CreateSpiralVM}">
            <view:SpiralSize VerticalAlignment="Top" HorizontalContentAlignment="Stretch" />
        </DataTemplate>

    </UserControl.DataTemplates>
    <Grid
        Background="#02FFFFFF"
        Cursor="{Binding Cursor}"
        ShowGridLines="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>
        <Image Grid.Row="0" Source="{Binding Path=CurrentPlan}" />
        <ScrollViewer
            Grid.RowSpan="2"
            Grid.Column="1"
            HorizontalAlignment="Stretch"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="3">
                <Expander
                    Content="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Grid}}, Path=DataContext}"
                    Header="{local:Gettext Basic Settings Header|Shape settings}"
                    IsExpanded="True" />
                <Expander
                    Content="{Binding ImageTreatmentVM}"
                    Header="{local:Gettext Basic Settings Header|Image treatment settings}"
                    IsExpanded="True" />
                <Expander
                    Content="{Binding CalculationVM}"
                    Header="{local:Gettext Basic Settings Header|Color search settings}"
                    IsExpanded="True" />
                <Expander
                    HorizontalAlignment="Stretch"
                    Header="{local:Gettext Basic Settings Header|Render options}"
                    IsExpanded="True">
                    <HeaderedContentControl Header="{local:Gettext Preview options}">
                        <view:RenderOptions
                            BackgroundColor="{Binding BackgroundColor}"
                            Collapse="{Binding Collapsed}"
                            Collapsible="{Binding Collapsible, Mode=OneWay}"
                            DrawBorders="{Binding Draw_borders}"
                            ShowImageSize="false" />
                    </HeaderedContentControl>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <local:ImageButton
                Command="{Binding EditClick}"
                Content="{local:Gettext Edit}"
                Image="/Icons/draw_freehand.ico" />
            <local:ImageButton
                Command="{Binding BuildtoolsClick}"
                Content="{local:Gettext Buildtools}"
                Image="/Icons/file_export.ico"
                IsVisible="{Binding VisibleFieldplan}" />
        </StackPanel>
    </Grid>
</UserControl>
