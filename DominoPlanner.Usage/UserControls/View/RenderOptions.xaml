<UserControl
    x:Class="DominoPlanner.Usage.UserControls.View.RenderOptions"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DominoPlanner.Usage"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ucView="using:DominoPlanner.Usage.UserControls.View"
    d:DesignHeight="300"
    d:DesignWidth="350"
    x:DataType="ucView:RenderOptions"
    mc:Ignorable="d">
    <Grid x:Name="LayoutRoot" Margin="5">
        <StackPanel>
            <DockPanel
                Grid.Row="0"
                Margin="0,5,0,0"
                VerticalAlignment="Center"
                DockPanel.Dock="Top"
                IsVisible="{Binding ShowImageSize}">
                <TextBlock VerticalAlignment="Center" Text="{local:Gettext Image size (larger side):}" />
                <NumericUpDown
                    Width="100"
                    HorizontalAlignment="Right"
                    Maximum="{Binding MaxSize}"
                    Minimum="200"
                    Value="{Binding ImageSize}" />
            </DockPanel>
            <DockPanel
                Grid.Row="1"
                Margin="0,5,0,0"
                VerticalAlignment="Center"
                DockPanel.Dock="Top">
                <TextBlock VerticalAlignment="Center" Text="{local:Gettext Background color:}" />
                <local:PopupColorPicker Color="{Binding BackgroundColor, Mode=TwoWay}" />
            </DockPanel>
            <DockPanel
                Grid.Row="2"
                Height="26"
                Margin="0,5,0,0"
                VerticalAlignment="Center"
                DockPanel.Dock="Top">
                <CheckBox
                    Grid.Row="2"
                    VerticalAlignment="Center"
                    Content="{local:Gettext Draw Domino Borders}"
                    IsChecked="{Binding DrawBorders}" />
            </DockPanel>

            <CheckBox
                Grid.Row="3"
                Height="26"
                Margin="0,5,0,0"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center"
                Content="{local:Gettext Remove spaces between dominoes}"
                IsChecked="{Binding Collapse}"
                IsVisible="{Binding Collapsible}" />
        </StackPanel>

    </Grid>
</UserControl>
