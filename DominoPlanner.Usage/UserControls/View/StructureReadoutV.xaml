<UserControl
    x:Class="DominoPlanner.Usage.UserControls.View.StructureReadoutV"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:DominoPlanner.Core;assembly=DominoPlanner.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DominoPlanner.Usage"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="using:DominoPlanner.Usage.UserControls.ViewModel"
    d:DesignHeight="100"
    d:DesignWidth="300"
    x:DataType="viewmodel:NormalReadoutVM"
    mc:Ignorable="d">
    <UserControl.Resources>
        <local:EnumBooleanConverter x:Key="EnumBooleanConverter" />
    </UserControl.Resources>
    <Grid>
        <HeaderedContentControl DockPanel.Dock="Top" Header="{local:Gettext Image readout}">
            <DockPanel>
                <Grid
                    Grid.Row="4"
                    ColumnDefinitions="*, *"
                    DockPanel.Dock="Top">
                    <RadioButton
                        Grid.Column="0"
                        Margin="5"
                        HorizontalAlignment="Left"
                        VerticalContentAlignment="Center"
                        Content="{local:Gettext Single Pixel\\n(top left corner)}"
                        GroupName="a"
                        IsChecked="{Binding AverageMode, Converter={StaticResource EnumBooleanConverter}, ConverterParameter={x:Static core:AverageMode.Corner}}" />
                    <RadioButton
                        Grid.Column="1"
                        Margin="5"
                        HorizontalAlignment="Left"
                        VerticalContentAlignment="Center"
                        Content="{local:Gettext Average of\\nSource Area}"
                        GroupName="a"
                        IsChecked="{Binding AverageMode, Converter={StaticResource EnumBooleanConverter}, ConverterParameter={x:Static core:AverageMode.Average}}" />
                </Grid>
                <CheckBox
                    Grid.Row="6"
                    Margin="5"
                    Content="{local:Gettext Fit Image to Structure Size}"
                    DockPanel.Dock="Top"
                    IsChecked="{Binding AllowStretch}" />
                <DockPanel
                    Margin="0,5,0,0"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Top">
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{local:Gettext Image background:}"
                        ToolTip.Tip="{local:Gettext 'For transparent images, set background color here. In order to use transparency threshold, background must be transparent'}" />
                    <local:PopupColorPicker Color="{Binding Background, Mode=TwoWay}" />
                </DockPanel>
            </DockPanel>
        </HeaderedContentControl>
    </Grid>
</UserControl>
