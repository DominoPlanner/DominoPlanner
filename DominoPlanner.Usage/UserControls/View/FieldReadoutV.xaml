<UserControl
    x:Class="DominoPlanner.Usage.UserControls.View.FieldReadoutV"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DominoPlanner.Usage"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:DominoPlanner.Usage.UserControls.ViewModel"
    d:DesignHeight="50"
    d:DesignWidth="200"
    x:DataType="viewModels:FieldReadoutVM"
    mc:Ignorable="d">
    <UserControl.Resources>
        <local:FilterQualityToIntConverter x:Key="EnumToIntConverter" />
        <local:FilterQualityToStringConverter x:Key="InterToStringConverter" />
    </UserControl.Resources>
    <Grid>
        <HeaderedContentControl Header="{Binding ResizeQuality, Converter={StaticResource InterToStringConverter}, StringFormat={local:Gettext 'Resize Quality: {0}'}}">
            <DockPanel>
                <Grid ColumnDefinitions="1*, 3*, 1.5*" DockPanel.Dock="Top">
                    <TextBlock
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="{local:Gettext Rough interpolation|Pixel}" />
                    <Slider
                        Grid.Column="1"
                        Margin="0,5,0,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        IsSnapToTickEnabled="True"
                        LargeChange="1"
                        Maximum="2"
                        Minimum="0"
                        SmallChange="1"
                        TickFrequency="1"
                        TickPlacement="BottomRight"
                        Value="{Binding ResizeQuality, Converter={StaticResource EnumToIntConverter}}" />
                    <TextBlock
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Text="{local:Gettext Fine interpolation|Smooth}" />
                </Grid>
                <DockPanel
                    Grid.Row="1"
                    Margin="0,5,0,0"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Top">
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{local:Gettext Image background:}"
                        ToolTip.Tip="{local:Gettext 'For transparent images, set background color here. In order to use transparency threshold, background must be transparent'}" />
                    <local:PopupColorPicker Color="{Binding Background, Mode=TwoWay}" />
                </DockPanel>
            </DockPanel>
        </HeaderedContentControl>
    </Grid>
</UserControl>
