<Window
    x:Class="DominoPlanner.Usage.ReferenceManager"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DominoPlanner.Usage"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{local:Gettext Window title|Manage references}"
    Width="800"
    Height="450"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="local:ReferenceManagerViewModel"
    mc:Ignorable="d">
    <Window.Resources>
        <local:BoolInverterConverter x:Key="BoolInverterConverter" />
    </Window.Resources>
    <Border
        Margin="2"
        BorderBrush="{DynamicResource ThemeBorderHighBrush}"
        BorderThickness="1"
        Grid.IsSharedSizeScope="True">
        <DockPanel>
            <Grid DockPanel.Dock="Top">
                <Grid.Styles>
                    <Style Selector="TextBlock">
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="Margin" Value="5 2" />
                    </Style>
                </Grid.Styles>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" SharedSizeGroup="A" />
                    <ColumnDefinition
                        Width="Auto"
                        MaxWidth="200"
                        SharedSizeGroup="B" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="C" />
                    <ColumnDefinition
                        Width="Auto"
                        MaxWidth="300"
                        SharedSizeGroup="D" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="{local:Gettext Parent path}" />
                <GridSplitter
                    Grid.Column="1"
                    Width="2"
                    HorizontalAlignment="Right"
                    ResizeDirection="Columns" />

                <TextBlock Grid.Column="2" Text="{local:Gettext Relative path}" />
                <GridSplitter
                    Grid.Column="2"
                    Width="2"
                    HorizontalAlignment="Right"
                    ResizeDirection="Columns" />
                <TextBlock Grid.Column="3" Text="{local:Gettext Resolved absolute path}" />
                <GridSplitter
                    Grid.Column="3"
                    Width="2"
                    HorizontalAlignment="Right"
                    ResizeDirection="Columns" />
            </Grid>
            <ListBox ItemsSource="{Binding VMs}">
                <ListBox.DataTemplates>
                    <DataTemplate DataType="{x:Type local:PathResolutionVM}">
                        <Grid DockPanel.Dock="Top">
                            <Interaction.Behaviors>
                                <EventTriggerBehavior EventName="DoubleTapped">
                                    <InvokeCommandAction Command="{Binding ReplacePathCommand}" />
                                </EventTriggerBehavior>
                                <DataTriggerBehavior Binding="{Binding IsResolved}" Value="false">
                                    <ChangePropertyAction PropertyName="ContextMenu">
                                        <ChangePropertyAction.Value>
                                            <ContextMenu>
                                                <MenuItem Command="{Binding ReplacePathCommand}" Header="{local:Gettext Replace path}" />
                                            </ContextMenu>
                                        </ChangePropertyAction.Value>
                                    </ChangePropertyAction>
                                </DataTriggerBehavior>
                            </Interaction.Behaviors>
                            <Grid.Styles>
                                <Style Selector="TextBlock">
                                    <Setter Property="Margin" Value="5 2" />
                                </Style>
                            </Grid.Styles>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" SharedSizeGroup="A" />
                                <ColumnDefinition
                                    Width="Auto"
                                    MaxWidth="200"
                                    SharedSizeGroup="B" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="C" />
                                <ColumnDefinition
                                    Width="Auto"
                                    MaxWidth="300"
                                    SharedSizeGroup="D" />
                            </Grid.ColumnDefinitions>
                            <Image
                                Width="20"
                                Height="20"
                                IsVisible="{Binding IsResolved}"
                                Source="/Icons/ok.ico" />
                            <Image
                                Width="20"
                                Height="20"
                                IsVisible="{Binding IsResolved, Converter={StaticResource BoolInverterConverter}}"
                                Source="/Icons/closewindow.ico">
                                <Interaction.Behaviors>
                                    <EventTriggerBehavior EventName="PointerPressed">
                                        <InvokeCommandAction Command="{Binding ReplacePathCommand}" />
                                    </EventTriggerBehavior>
                                </Interaction.Behaviors>
                            </Image>
                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding ParentPath}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding RelativePath}" />
                            <TextBlock Grid.Column="3" Text="{Binding AbsolutePath}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.DataTemplates>
            </ListBox>
        </DockPanel>
    </Border>
</Window>
