<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <UserSecretsId>419a2851-2d31-44f4-af38-97c272d45edf</UserSecretsId>
    <Version>3.0.0.11</Version>
    <AssemblyVersion>3.0.0.11</AssemblyVersion>
    <FileVersion>3.0.0.11</FileVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType></DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="License-LGPL.txt" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="License-LGPL.txt" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="EPPlus" Version="8.6.1" />
    <PackageReference Include="protobuf-net" Version="2.4.6" />
    <PackageReference Include="SkiaSharp" Version="4.148.0" />
  </ItemGroup>
  <PropertyGroup>
    <SignAssembly>true</SignAssembly>
  </PropertyGroup>
  <PropertyGroup>
    <AssemblyOriginatorKeyFile>DominoPlanner.Core.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>$(DefineConstants);_MasterplanExport</DefineConstants>
  </PropertyGroup>
</Project>
